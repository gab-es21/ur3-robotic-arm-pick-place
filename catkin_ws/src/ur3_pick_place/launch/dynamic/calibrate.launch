<?xml version="1.0"?>
<!-- Solves camera_link -> base_link; run once per camera mount before dynamic/sim.launch or dynamic/real.launch. -->
<launch>
  <arg name="marker_id" default="582"/>
  <arg name="marker_size" default="0.100"/>

  <node name="aruco_single" pkg="aruco_ros" type="single" output="screen">
    <remap from="/camera_info" to="/camera/color/camera_info"/>
    <remap from="/image" to="/camera/color/image_raw"/>
    <param name="image_is_rectified" value="true"/>
    <param name="marker_size" value="$(arg marker_size)"/>
    <param name="marker_id" value="$(arg marker_id)"/>
    <param name="reference_frame" value="base_link"/>
    <param name="camera_frame" value="camera_link"/>
    <param name="marker_frame" value="calibration_board"/>
  </node>

  <node name="camera_calibration" pkg="ur3_pick_place" type="camera_calibration.py" output="screen"/>
</launch>
