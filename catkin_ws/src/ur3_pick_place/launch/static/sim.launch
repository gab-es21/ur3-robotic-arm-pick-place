<?xml version="1.0"?>
<!--
  Approach 1 (static), in Gazebo. Fixed pick/place poses, no camera.
    source env/sim.env.sh && roslaunch ur3_pick_place static/sim.launch
-->
<launch>
  <include file="$(find ur3_pick_place)/launch/common/bringup_sim.launch"/>
  <include file="$(find ur3_pick_place)/launch/common/moveit_planning.launch"/>

  <node name="static_pick_place" pkg="ur3_pick_place" type="static_pick_place.py" output="screen"/>
</launch>
